# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=score_erp
DB_USER=postgres
DB_PASSWORD=postgres

# JSON Web Token
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS (comma-separated origins; * allows all)
CORS_ORIGIN=http://localhost:5173
